{
  "openapi": "3.1.0",
  "info": {
    "title": "OutdoorKing Intel",
    "version": "0.0.0",
    "description": "Internal itinerary planner, pricing hints, and similar-trip recommendations. HMAC-authenticated. Not public."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "status": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    },
    "/v1/pricing/suggest": {
      "post": {
        "summary": "Staff-only pricing suggestion",
        "security": [{ "OkHmac": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PricingIn" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Suggestion",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PricingOut" }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/v1/recommendations/similar": {
      "post": {
        "summary": "Similar trips",
        "security": [{ "OkHmac": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SimilarIn" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Slugs",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SimilarOut" }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/v1/itinerary/plan": {
      "post": {
        "summary": "Private itinerary plan (no prices)",
        "security": [{ "OkHmac": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PlanIn" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Plan",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PlanOut" }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/v1/analytics/summary": {
      "post": {
        "summary": "Staff-only analytics commentary",
        "security": [{ "OkHmac": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AnalyticsIn" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Summary",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AnalyticsOut" }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "OkHmac": {
        "type": "apiKey",
        "in": "header",
        "name": "X-OK-Signature"
      }
    },
    "schemas": {
      "PricingIn": {
        "type": "object",
        "required": ["durationDays", "partySize"],
        "properties": {
          "tripSlug": { "type": "string" },
          "activity": { "type": "string" },
          "durationDays": { "type": "integer" },
          "partySize": { "type": "integer" },
          "difficulty": { "type": "string" }
        }
      },
      "PricingOut": {
        "type": "object",
        "required": [
          "suggestedDepositPct",
          "landPackageHint",
          "confidence",
          "similarTripSlugs",
          "staffOnly"
        ],
        "properties": {
          "suggestedDepositPct": { "type": "integer" },
          "landPackageHint": { "type": "string" },
          "confidence": { "type": "number" },
          "similarTripSlugs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "staffOnly": { "type": "boolean" }
        }
      },
      "CatalogTrip": {
        "type": "object",
        "required": ["slug", "activity"],
        "properties": {
          "slug": { "type": "string" },
          "activity": { "type": "string" },
          "regions": { "type": "array", "items": { "type": "string" } },
          "durationTypical": { "type": "integer" }
        }
      },
      "SimilarIn": {
        "type": "object",
        "properties": {
          "tripSlug": { "type": "string" },
          "regionSlugs": { "type": "array", "items": { "type": "string" } },
          "activity": { "type": "string" },
          "durationDays": { "type": "integer" },
          "catalog": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CatalogTrip" }
          }
        }
      },
      "SimilarOut": {
        "type": "object",
        "required": ["slugs"],
        "properties": {
          "slugs": { "type": "array", "items": { "type": "string" } }
        }
      },
      "AnalyticsIn": {
        "type": "object",
        "properties": {
          "requests": { "type": "integer" },
          "quotesSent": { "type": "integer" },
          "quotesAccepted": { "type": "integer" },
          "bookings": { "type": "integer" }
        }
      },
      "PlanDay": {
        "type": "object",
        "required": [
          "dayNumber",
          "title",
          "startAltitudeM",
          "highPointM",
          "sleepAltitudeM",
          "dayType"
        ],
        "properties": {
          "dayNumber": { "type": "integer" },
          "title": { "type": "string" },
          "fromPlace": { "type": "string" },
          "toPlace": { "type": "string" },
          "startAltitudeM": { "type": "integer" },
          "highPointM": { "type": "integer" },
          "sleepAltitudeM": { "type": "integer" },
          "dayType": { "type": "string" }
        }
      },
      "PlanReason": {
        "type": "object",
        "required": ["id", "message"],
        "properties": {
          "id": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "SeasonFit": {
        "type": "object",
        "required": ["tripSeasons", "fit", "message"],
        "properties": {
          "month": { "type": "integer" },
          "season": { "type": "string" },
          "tripSeasons": { "type": "array", "items": { "type": "string" } },
          "fit": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "PlanIn": {
        "type": "object",
        "required": ["days"],
        "properties": {
          "days": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PlanDay" }
          },
          "month": { "type": "integer" },
          "pace": { "type": "string", "enum": ["relaxed", "steady", "fast"] },
          "maxPriorAltitudeM": { "type": "integer" },
          "usesLukla": { "type": "boolean" },
          "seasons": { "type": "array", "items": { "type": "string" } }
        }
      },
      "PlanOut": {
        "type": "object",
        "required": ["days", "seasonFit", "reasons"],
        "properties": {
          "days": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PlanDay" }
          },
          "seasonFit": { "$ref": "#/components/schemas/SeasonFit" },
          "reasons": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PlanReason" }
          }
        }
      },
      "AnalyticsOut": {
        "type": "object",
        "required": [
          "conversionRate",
          "bookingsPerRequest",
          "commentary",
          "mocked",
          "staffOnly"
        ],
        "properties": {
          "conversionRate": { "type": "number" },
          "bookingsPerRequest": { "type": "number" },
          "commentary": { "type": "string" },
          "mocked": { "type": "boolean" },
          "staffOnly": { "type": "boolean" }
        }
      }
    }
  }
}
